{
  "name": "card-issuer",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "npm run dev:tsc & npm run dev:node",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --enable-source-maps --watch dist/src/index.js",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./public/output.css",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "clean": "rimraf dist/",
    "build": "npm run clean && tsc",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "typescript": "^5.4.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.5"
  }
}
